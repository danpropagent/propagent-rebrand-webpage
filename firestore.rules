rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Live grade runs: the homepage lab reads one doc via its
    // unguessable client-generated id. No listing, no client writes.
    match /gradeRuns/{runId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Everything else (usage counters, opportunity docs, ask logs)
    // is server-only; the Admin SDK bypasses these rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
